{
  "name": "Life Command Center",
  "short_name": "Life Command",
  "description": "Plan your hours, protect your attention, and keep every task visible.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f0efe7",
  "theme_color": "#111514",
  "share_target": {
    "action": "/?share-target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Paper page", "short_name": "Paper", "url": "/#paper" },
    { "name": "Bulletin board", "short_name": "Board", "url": "/#board" },
    { "name": "Useful library", "short_name": "Library", "url": "/#library" }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
