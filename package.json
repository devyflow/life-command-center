{
  "name": "life-command-center",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "validate:vercel": "node scripts/validate-vercel.mjs",
    "test:experience": "node scripts/test-experience.mjs",
    "test": "npm run build && npm run validate && npm run validate:vercel && npm run test:experience",
    "check": "npm test && npm run build:vercel",
    "preview:qa": "node scripts/preview-experience.mjs"
  },
  "devDependencies": {
    "vercel": "^65.0.0"
  }
}
